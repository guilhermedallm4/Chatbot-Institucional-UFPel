# Copie para docker/.env e ajuste. Estes valores também precisam bater com
# aplicacao/.env (DB_USER, DB_PASS, DB_NAME, DB_PORT).
POSTGRES_USER=gdlima
POSTGRES_PASSWORD=12345
POSTGRES_DB=semanticdb
POSTGRES_PORT=5432
# 0.0.0.0 = aceita conexões externas; 127.0.0.1 = só a máquina local
POSTGRES_BIND=0.0.0.0

# Memória do PostgreSQL (ajuste à máquina)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB

# pgAdmin (perfil opcional: docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@ufpel.edu.br
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
