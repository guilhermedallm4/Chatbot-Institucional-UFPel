# ---------------------------------------------------------------------------
# PostgreSQL (deve bater com docker/.env)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=semanticdb
DB_USER=gdlima
DB_PASS=12345

# Usuário somente leitura usado pela ferramenta consultar_sql do agente
# (criado por docker/init/01_extensoes.sql). Se vazio, usa DB_USER.
DB_READONLY_USER=rag_leitor
DB_READONLY_PASS=leitor

# ---------------------------------------------------------------------------
# Embeddings: "local" (sentence-transformers, GPU/CPU, sem API) ou "nvidia"
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
# Dimensão do modelo em uso (bge-m3=1024; nemotron-3-embed-1b=2048). Mudou? Rode os
# loaders de crawler/ com --schema para recriar as tabelas emb_* nessa dimensão.
EMBEDDING_DIMS=1024
# Para usar a NVIDIA: EMBEDDING_PROVIDER=nvidia, NVIDIA_API_KEY e o modelo abaixo
EMBEDDING_MODEL_NVIDIA=nvidia/nv-embedqa-e5-v5

# ---------------------------------------------------------------------------
# Agente local (LiquidAI LFM2.5)
# ---------------------------------------------------------------------------
AGENT_MODEL_ID=LiquidAI/LFM2.5-2.6B
# Onde rodar o LLM: auto (GPU se houver) | cuda | cpu. Em cpu o dtype padrão vira float32
# (a CPU desta máquina só tem AVX2: bfloat16 é emulado e fica mais lento que fp32).
AGENT_DEVICE=auto
AGENT_DTYPE=auto
# Threads de CPU (padrão: todos os núcleos)
# AGENT_CPU_THREADS=24
AGENT_MAX_NEW_TOKENS=2048
AGENT_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# APIs externas (opcionais — só para o pipeline LangChain original)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
FEATURE_NVIDIA_LLM=false
